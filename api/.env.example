# Copy to api/.env for local development. Never commit api/.env.
NODE_ENV=development
PORT=3000
# Atlas connection string for your own database user (placeholder shown).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Local: familyforward_dev. Production (Render): familyforward_prod.
DB_NAME=familyforward_dev
LOG_LEVEL=info
# Auth. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both must be at least 32 characters and different from each other.
JWT_SECRET=
CODE_HMAC_SECRET=
# Email (Resend). Optional in development: the sign-in code is printed to the console instead.
# Required in production. Never set these in a committed file.
RESEND_API_KEY=
MAIL_FROM=
# Plan generation: mock (default) or claude.
LLM_PROVIDER=mock
# Only needed when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Plans each parent can generate per day.
PLAN_DAILY_LIMIT=5
