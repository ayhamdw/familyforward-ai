{
  "info": {
    "name": "FamilyForward API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Auth first (request-code, then verify with the code; in development without a Resend key the code is printed in the API terminal). Then add a child, make a plan, and try the rest."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "email",
      "value": "parent@example.com"
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "childId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET /health/db",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "db"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/request-code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/request-code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "request-code"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 {ok:true}', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({ok:true}); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/verify",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Children",
      "item": [
        {
          "name": "POST /children",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "children"
              ]
            },
            "description": "Nickname 1-20 characters, age band 2-3 or 4-5, home languages en, es, ar, other. Up to 4 children (409 child_limit).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Sunny\",\n  \"ageBand\": \"2-3\",\n  \"homeLanguages\": [\n    \"en\",\n    \"es\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('childId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /children",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/children",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "children"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /children/:id",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/children/{{childId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "children",
                "{{childId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"Sol\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE /children/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/children/{{childId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "children",
                "{{childId}}"
              ]
            },
            "description": "Also deletes the child's surveys and plans.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Plans",
      "item": [
        {
          "name": "POST /plans",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            },
            "description": "Age band and home languages come from the child. Add \"regenerate\": true to replace this week's plan, and \"previousPlanId\" to build on last week's reactions. 409 plan_exists, 429 plan_daily_limit. The response has noteIgnored (true only when a clean note went unused).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"childId\": \"{{childId}}\",\n  \"language\": \"en\",\n  \"focusAreas\": [\n    \"talking\",\n    \"movement\"\n  ],\n  \"interests\": [\n    \"songs\",\n    \"outdoors\"\n  ],\n  \"materials\": [\n    \"paper\",\n    \"kitchen\",\n    \"toys\"\n  ],\n  \"minutesPerDay\": 10,\n  \"daysPerWeek\": 3,\n  \"note\": \"Optional, up to 140 characters. Never stored.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('planId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /plans/current",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans/current?childId={{childId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "current"
              ],
              "query": [
                {
                  "key": "childId",
                  "value": "{{childId}}"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /plans (past weeks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/plans?childId={{childId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ],
              "query": [
                {
                  "key": "childId",
                  "value": "{{childId}}"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /plans/:planId/activities/:index",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}/activities/0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}",
                "activities",
                "0"
              ]
            },
            "description": "reaction is loved, fine, didnt_work or null.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"done\": true,\n  \"reaction\": \"loved\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /plans/:planId/checkin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}/checkin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}",
                "checkin"
              ]
            },
            "description": "One answer per check-in question (yes, somewhat or no).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    \"yes\",\n    \"somewhat\",\n    \"no\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "DELETE /me",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            },
            "description": "Deletes the parent, children, surveys, plans and codes. The token stops working.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
